{
  "expo": {
    "name": "Reminder Offline",
    "slug": "reminder-offline",
    "version": "1.0.1",
    "icon": "./assets/images/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "reminderoffline",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.buggerspot.reminderoffline",
      "infoPlist": {
        "NSUserNotificationUsageDescription": "Offline Reminder uses notifications to remind you about events you create."
      }
    },
    "android": {
      "package": "com.buggerspot.reminderoffline",
      "permissions": [
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK",
        "SCHEDULE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "reminders",
          "enableBackgroundRemoteNotifications": false,
          "sounds": [
            "./assets/sounds/reminder.wav",
            "./assets/sounds/gentle.wav",
            "./assets/sounds/bright.wav",
            "./assets/sounds/arabian_mystery.wav",
            "./assets/sounds/bell_notification.wav",
            "./assets/sounds/happy_bells.wav",
            "./assets/sounds/musical_alert.wav"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#058B7E",
          "image": "./assets/images/icon.png",
          "imageWidth": 200
        }
      ],
      "expo-document-picker",
      "expo-file-system",
      "expo-sharing",
      "./plugins/withReminderNative.cjs"
    ],
    "extra": {
      "privacy": "offline-first; no account, analytics, or backend configured",
      "eas": {
        "projectId": "67ff1295-5277-4b69-b25e-111f895034ab"
      }
    },
    "owner": "buggerspot"
  }
}
